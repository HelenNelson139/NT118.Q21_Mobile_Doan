<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardPendingModule"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="6dp"
    android:layout_marginEnd="6dp"
    android:layout_marginTop="10dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="1dp"
    app:strokeColor="#2196F3">

    <LinearLayout
        android:id="@+id/layoutPendingModuleRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:id="@+id/txtPendingModuleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Tên bài giảng"
            android:textColor="#112D4E"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtPendingModuleStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Trạng thái: PENDING"
            android:textColor="#555555"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtPendingModuleObjective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Mục tiêu:"
            android:textColor="#112D4E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtPendingModuleContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Nội dung:"
            android:textColor="#112D4E"
            android:textSize="14sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/txtPendingModuleExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Ví dụ:"
            android:textColor="#112D4E"
            android:textSize="14sp"
            android:maxLines="2"
            android:ellipsize="end" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnViewPendingModule"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginTop="12dp"
            android:text="Xem chi tiết"
            android:textAllCaps="false"
            android:textColor="#2196F3"
            app:backgroundTint="#BBDEFB"
            app:cornerRadius="8dp"
            app:strokeWidth="1dp"
            app:strokeColor="#2196F3" />

        <LinearLayout
            android:id="@+id/layoutPendingActionButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApprovePendingModule"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Duyệt"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#2E7D32"
                app:cornerRadius="8dp" />

            <Space
                android:layout_width="10dp"
                android:layout_height="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApproveDeletePendingModule"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1"
                android:text="Duyệt xoá"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:backgroundTint="#D32F2F"
                app:cornerRadius="8dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>