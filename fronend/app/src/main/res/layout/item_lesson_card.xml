<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_lesson_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_toLeftOf="@id/btnDeleteModule"
        android:layout_alignParentStart="true">

        <TextView
            android:id="@+id/txtChapterLesson"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"/>

        <TextView
            android:id="@+id/txtLessonTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:layout_marginTop="4dp"/>
    </LinearLayout>

    <ImageView
        android:id="@+id/btnDeleteModule"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentEnd="true"
        android:layout_centerInParent="true"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Xóa module"
        android:padding="4dp"
        android:background="?attr/selectableItemBackgroundBorderless"/>

</RelativeLayout>