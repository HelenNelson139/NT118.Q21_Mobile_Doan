<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="12dp"
    android:backgroundTint="@android:color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="6dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/bright_blue">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="14dp">

        <!-- TÊN BÀI HỌC -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tên bài học"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/txtModuleTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:hint="Nhập tên bài học..." />

        <!-- MỤC TIÊU -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mục tiêu"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginStart="12dp"
            android:layout_marginTop="4dp" />

        <EditText
            android:id="@+id/txtObjective"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:hint="Mục tiêu" />

        <!-- NỘI DUNG -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nội dung"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/txtContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:hint="Nội dung" />

        <!-- VÍ DỤ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ví dụ"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginStart="12dp"
            android:layout_marginTop="10dp" />

        <EditText
            android:id="@+id/txtExample"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_example"
            android:padding="10dp"
            android:typeface="monospace"
            android:textSize="13sp"
            android:minLines="3"
            android:gravity="top"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="6dp"
            android:hint="Ví dụ" />

        <!-- PREVIEW VIDEO -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Video bài học"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginStart="12dp"
            android:layout_marginTop="16dp" />

        <androidx.media3.ui.PlayerView
            android:id="@+id/videoPreview"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp"
            android:background="#000000"
            android:visibility="gone"
            app:use_controller="true"
            app:resize_mode="fit" />

        <TextView
            android:id="@+id/txtSelectedVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa chọn video"
            android:textColor="@color/dark_blue"
            android:textSize="14sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadVideo"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/light_blue"
            android:text="Chọn video bài học"
            android:textSize="16sp"
            android:textColor="@color/bright_blue"
            app:cornerRadius="12dp"
            app:strokeColor="@color/bright_blue"
            app:strokeWidth="2dp" />

        <!-- FILE TÀI LIỆU -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="File tài liệu"
            android:textStyle="bold"
            android:textSize="18sp"
            android:textColor="@color/dark_blue"
            android:layout_marginStart="12dp"
            android:layout_marginTop="18dp" />

        <TextView
            android:id="@+id/txtSelectedDocument"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa chọn file tài liệu"
            android:textColor="@color/dark_blue"
            android:textSize="14sp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadDocument"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/light_blue"
            android:text="Chọn file tài liệu"
            android:textSize="16sp"
            android:textColor="@color/bright_blue"
            app:cornerRadius="12dp"
            app:strokeColor="@color/bright_blue"
            app:strokeWidth="2dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>