<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="top|center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Đăng ký\n tài khoản"
            android:textSize="42sp"
            android:textStyle="bold"
            android:textColor="#FFB74D"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="LOẠI TÀI KHOẢN"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <RadioGroup
            android:id="@+id/radioRoleGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

            <RadioButton
                android:id="@+id/radioTeacher"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Giảng viên"
                android:textColor="#FFFFFF"
                android:checked="true" />

            <RadioButton
                android:id="@+id/radioStudent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Học viên"
                android:textColor="#FFFFFF"
                android:layout_marginStart="30dp" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TÊN ĐĂNG NHẬP"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/editUsername"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#D9D9D9"
            android:layout_marginBottom="16dp"
            android:hint="Nhập tên đăng nhập"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HỌ VÀ TÊN"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/editName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#D9D9D9"
            android:layout_marginBottom="16dp"
            android:hint="Nhập Họ và Tên"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="EMAIL"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/editEmail"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#D9D9D9"
            android:layout_marginBottom="16dp"
            android:hint="Nhập email"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:singleLine="true"
            android:inputType="textEmailAddress"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SỐ ĐIỆN THOẠI"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/editPhone"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#D9D9D9"
            android:layout_marginBottom="16dp"
            android:hint="Nhập số điện thoại"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:singleLine="true"
            android:inputType="phone"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="MẬT KHẨU"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/editPassword"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#D9D9D9"
            android:layout_marginBottom="16dp"
            android:hint="Nhập mật khẩu"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:singleLine="true"
            android:inputType="textPassword"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:id="@+id/textExtraLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="KHOA"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <EditText
            android:id="@+id/editExtraInfo"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="#D9D9D9"
            android:layout_marginBottom="16dp"
            android:hint="Nhập khoa"
            android:textColor="#000000"
            android:textColorHint="#666666"
            android:singleLine="true"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ẢNH ĐẠI DIỆN"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#78b3e7"
            android:layout_marginBottom="7dp" />

        <ImageView
            android:id="@+id/imgAvatarPreview"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginBottom="10dp"
            android:background="#D9D9D9"
            android:padding="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile" />

        <Button
            android:id="@+id/buttonPickAvatar"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_marginBottom="26dp"
            android:text="Chọn ảnh"
            android:textStyle="bold"
            android:textColor="@color/button_text"
            android:backgroundTint="@color/button_background" />

        <Button
            android:id="@+id/buttonSubmitRegister"
            android:layout_width="235dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/button_background"
            android:text="Đăng ký"
            android:textColor="@color/button_text"
            android:textStyle="bold"
            android:textSize="22sp" />

    </LinearLayout>
</ScrollView>